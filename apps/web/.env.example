# ========================================================
# Noor Islamic Library — Environment Configuration
# ========================================================

# 1. Database (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_ENDPOINT.neon.tech/neondb?sslmode=require"

# 2. Authentication & Cookie Security
# Set to "false" for local HTTP dev, and "true" for Vercel production HTTPS
AUTH_COOKIE_SECURE="false"

# 3. Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID="f7yazuq4"
NEXT_PUBLIC_SANITY_DATASET="ace-noor"
NEXT_PUBLIC_SANITY_API_VERSION="2024-03-15"

# 4. App URL (Used for Password Reset & Canonical links)
# In production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. Email Service (Resend)
# Get a free API key at https://resend.com (3,000 emails/mo free)
# Leave empty for dev mode (reset links will print to server console)
RESEND_API_KEY=""
EMAIL_FROM="Noor Library <onboarding@resend.dev>"

# 6. Default Admin Account
ADMIN_EMAIL="admin@noor.app"
