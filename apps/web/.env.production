# DATABASE_URL for production PostgreSQL (required for deployment)
# Options:
#   - Vercel Postgres: postgresql://... (from Vercel dashboard)
#   - Neon: postgresql://... (from neon.tech)
#   - Supabase: postgresql://... (from supabase.com)
DATABASE_URL="postgresql://user:password@host:5432/noor"

# Cookie security - set to "true" in production (HTTPS)
AUTH_COOKIE_SECURE="true"
