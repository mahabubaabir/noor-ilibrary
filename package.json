{
  "name": "noor-islamic-library",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "prebuild": "npx prisma generate --schema=apps/web/prisma/schema.prisma",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "db:generate": "npm run db:generate -w apps/web",
    "db:push": "npm run db:push -w apps/web"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "@tailwindcss/postcss": true,
    "tailwindcss": true,
    "@swc/helpers": true,
    "lightningcss": true,
    "@tailwindcss/oxide": true,
    "unrs-resolver": true
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "devDependencies": {
    "es-abstract": "^1.23.3"
  }
}
